mpc:
  parameters:
{%- for param in online_parameters %}
{%- if param.type == 'list' %}
    {{ param.name }}: [{% for i in range(param.size) %}{{ param.value[i] }}{% if not loop.last %}, {% endif %}{% endfor %}] # {{ param.description }}
{%- else %}
    {{ param.name }}: [{{ param.value }}] # {{ param.description }}
{%- endif %}
{%- endfor %}
  constraints:
    # Lower bounds for control inputs: [thrust, wx, wy, wz]
    lbu: [{% for i in range(total_nu) %}0.0{% if not loop.last %}, {% endif %}{% endfor %}]
    # Upper bounds for control inputs: [thrust, wx, wy, wz]
    ubu: [{% for i in range(total_nu) %}0.0{% if not loop.last %}, {% endif %}{% endfor %}]
    # Lower bounds on x at shooting nodes (1 to N)
    lbx: []
    # Upper bounds on x at shooting nodes (1 to N)
    ubx: []
    # Lower bounds on slacks at shooting nodes (1 to N)
    lsbx: []
    # Upper bounds on slacks at shooting nodes (1 to N)
    usbx: []
    # Lower bounds for nonlinear constraints h = ||v||^2 (always >= 0, so lower is inactive)
    lh: [0.0]
    # Upper bounds for nonlinear constraints h = ||v||^2 (always >= 0, so upper is active)
    uh: [0.0]
    # Diagonal Hessian weights for lower slack variables
    Zl: [0.0]
    # Diagonal Hessian weights for upper slack variables
    Zu: [0.0]
    # Linear weights for lower slack variables
    zl: [0.0]
    # Linear weights for upper slack variables
    zu: [0.0]
    # Diagonal Hessian weights for lower slack variables at end state
    Zl_e: [0.0]
    # Diagonal Hessian weights for upper slack variables at end state
    Zu_e: [0.0]
    # Linear weights for lower slack variables at end state
    zl_e: [0.0]
    # Linear weights for upper slack variables at end state
    zu_e: [0.0]
